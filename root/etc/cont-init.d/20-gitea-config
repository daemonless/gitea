#!/bin/sh
# Initialize Gitea configuration

# Ensure directories exist and have correct permissions
mkdir -p /config/data /config/custom/conf /config/repos /config/log /config/lfs /config/tmp /config/bin
chown -R bsd:bsd /config

# Copy gitea binary to volume (workaround for Podman overlay filesystem setuid issue)
# s6-setuidgid can't exec binaries from overlay fs when dropping privileges
if [ ! -f /config/bin/gitea ] || [ /usr/local/sbin/gitea -nt /config/bin/gitea ]; then
    echo "Copying gitea binary to volume..."
    cp /usr/local/sbin/gitea /config/bin/gitea
    chmod 755 /config/bin/gitea
    chown bsd:bsd /config/bin/gitea
fi

# If no config exists, create a minimal one
if [ ! -f /config/custom/conf/app.ini ]; then
    cat > /config/custom/conf/app.ini << EOF
APP_NAME = Gitea: Git with a cup of tea
RUN_USER = bsd
WORK_PATH = /config
RUN_MODE = prod

[repository]
ROOT = /config/repos

[server]
APP_DATA_PATH = /config/data
STATIC_ROOT_PATH = /usr/local/share/gitea
DOMAIN = localhost
HTTP_PORT = 3000
ROOT_URL = http://localhost:3000/
SSH_DOMAIN = %(DOMAIN)s
SSH_USER = git
DISABLE_SSH = false
SSH_PORT = ${SSH_PORT:-2222}
SSH_LISTEN_PORT = ${SSH_LISTEN_PORT:-22}
LFS_START_SERVER = true
OFFLINE_MODE = true

[database]
PATH = /config/data/gitea.db
DB_TYPE = sqlite3

[log]
MODE = console
LEVEL = info

[security]
INSTALL_LOCK = false

[lfs]
PATH = /config/lfs

[mailer]
ENABLED = false

[cron.update_checker]
ENABLED = false
EOF
    chown bsd:bsd /config/custom/conf/app.ini
    echo "Created default app.ini - run initial setup at http://localhost:3000/"
fi

# GITEA__<section>__<KEY> variables (the database choice, or any setting)
# go into app.ini on every start, as upstream's Docker image does. As bsd:
# gitea refuses to run as root. Empty ones are dropped first: the compose
# lists them all, and an empty DB_TYPE or HOST would overwrite a database
# set up through the web installer.
for v in $(env | sed -n 's/^\(GITEA__[A-Za-z0-9_]*\)=$/\1/p'); do
    unset "$v"
done
if env | grep -q '^GITEA__'; then
    /usr/local/bin/s6-setuidgid bsd /config/bin/gitea config edit-ini --in-place --apply-env \
        --work-path /config --config /config/custom/conf/app.ini
fi
